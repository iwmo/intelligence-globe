# PostgreSQL
POSTGRES_DB=opensignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Backend
FRONTEND_ORIGIN=http://localhost:8085
VERSION=0.1.0

# API Authentication — used by Phase 28 middleware to protect write endpoints
API_KEY=your-secret-api-key
# Frontend API key — must match API_KEY; sent as X-API-Key header when submitting OSINT events
VITE_API_KEY=your-secret-api-key

# ADSB.lol API — override only when using a compatible mirror.
ADSBIO_BASE_URL=https://re-api.adsb.lol

# AISStream.io — get your key at https://aisstream.io/
AISSTREAM_API_KEY=your-aisstream-api-key

# Cesium Ion — get your free token at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Voice (Wave 2) — server-side only. Leave empty to keep the mic unavailable.
OPENAI_API_KEY=

# Wave 3 feeds — server-side only. Never VITE_.
# NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/area/) — fires stay unavailable if empty.
FIRMS_MAP_KEY=
# Launch Library 2 token — optional; anonymous quota works for the upcoming roster.
LL2_API_TOKEN=

# Places / traffic — server-side only. Never VITE_.
# Google Geocoding + Nearby Search. Empty = Nominatim fallback; nearby stays off.
GOOGLE_MAPS_API_KEY=
# TomTom Traffic Flow. Empty = OSM simulated traffic dots (white).
TOMTOM_API_KEY=
# Soft daily cap on TomTom flow samples (9 per viewport refresh).
TOMTOM_DAILY_SAMPLE_BUDGET=2000
